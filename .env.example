# Copie para .env (ou exporte no terminal) para rodar localmente.

# Chave do provedor de LLM. Padrão: Groq (gratuito) - https://console.groq.com/keys
LLM_API_KEY=gsk_xxx

# Opcional: trocar o provedor/modelo (veja a tabela no README)
# LLM_MODEL=openai/llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Token GitHub (fine-grained PAT) com leitura nos repos das PoCs
# (Contents, Issues, Pull requests: Read). Desnecessário para repos públicos.
GITHUB_TOKEN=github_pat_xxx
# POC_GITHUB_TOKEN=
