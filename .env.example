# Copie para .env (ou exporte no terminal) para rodar localmente.

# Token GitHub (fine-grained PAT) com:
#   - Repository permissions > Contents, Issues, Pull requests: Read (nos repos das PoCs)
#   - Account permissions > Models: Read (para usar o GitHub Models)
GITHUB_TOKEN=github_pat_xxx

# Opcional: token separado só para ler os repos das PoCs (padrão: GITHUB_TOKEN)
# POC_GITHUB_TOKEN=

# Opcional: trocar o modelo. Padrão: GitHub Models gpt-4o-mini
# LLM_MODEL=openai/openai/gpt-4o-mini
# Migrar para o Claude depois (pip install "crewai[anthropic]"):
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_BASE_URL=
# LLM_API_KEY=sk-ant-xxx
